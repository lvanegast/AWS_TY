# ==========================================
# Configuración de LocalStack Hub
# ==========================================

# Servicios habilitados de AWS (separados por coma)
SERVICES=s3,sqs,sns,dynamodb,lambda,secretsmanager,ssm,iam,cloudwatch

# Región por defecto para los servicios locales
AWS_DEFAULT_REGION=us-east-1

# Credenciales simuladas (pueden ser cualquier valor)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Habilitar persistencia de datos (1 = sí, 0 = datos efímeros en RAM)
PERSISTENCE=1

# Nivel de depuración de LocalStack (0 = normal, 1 = debug)
DEBUG=0

# Host y puerto expuestos
LOCALSTACK_PORT=4566
