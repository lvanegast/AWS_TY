# ========================================================
# Variables de Entorno para Conectar Proyectos Clientes
# ========================================================

# Credenciales simuladas (LocalStack acepta cualquier valor ficticio)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# SI TU PROYECTO CORRE DIRECTAMENTE EN TU HOST (Windows / Terminal):
AWS_ENDPOINT_URL=http://localhost:4566

# SI TU PROYECTO CORRE DENTRO DE UN CONTENEDOR DOCKER (en la red aws-local-net):
# AWS_ENDPOINT_URL=http://localstack:4566
